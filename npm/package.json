    "vaqum": "bin/vaqum.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test"
  },
  "keywords": [
    "compression",
    "zstd",
    "lzma",
    "shred",
    "cli",
    "diff",
    "dedupe"
  ],
