  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcdomain/vaqum.git"
  },
  "homepage": "https://github.com/marcdomain/vaqum#readme",
  "os": [
    "darwin",
    "linux",
    "android",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=16"
  }
}
